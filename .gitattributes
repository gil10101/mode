# Checkouts keep LF everywhere (Windows runners default to autocrlf=true, which
# would turn fixture and template files into CRLF and change test outputs).
* text=auto eol=lf
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.mp4 binary
*.db binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.zip binary
